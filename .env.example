# 方案一：DeepSeek 在线模型（默认）
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=请替换为你的API_KEY
MODEL_BASE_URL=https://api.deepseek.com

# 也兼容你课程项目中已有的变量名：
# DEEPSEEK_API_KEY=请替换为你的API_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 方案二：Ollama 本地模型。使用时注释上面的 DeepSeek 配置，启用下面三行。
# MODEL_PROVIDER=ollama
# MODEL_NAME=deepseek-r1:1.5b
# MODEL_BASE_URL=http://localhost:11434

# 工具最多连续调用多少轮，防止异常情况下无限循环。
MAX_TOOL_ROUNDS=6

# 是否在终端显示模型选择了哪些工具。
SHOW_TOOL_TRACE=true

# 可选：开启 LangSmith 追踪。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=请替换为你的LANGSMITH_API_KEY
# LANGSMITH_PROJECT=ai-productivity-toolbox
